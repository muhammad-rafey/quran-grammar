{
  "name": "quran-grammar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @quran-grammar/api\" \"npm run dev -w @quran-grammar/web\"",
    "dev:mobile": "npm run start -w @quran-grammar/mobile",
    "build": "npm run build -w @quran-grammar/web && npm run build -w @quran-grammar/api",
    "build:mobile": "npm run export -w @quran-grammar/mobile",
    "start": "npm run start -w @quran-grammar/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.3"
  }
}
