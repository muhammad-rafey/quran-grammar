   "id": "33:7:13",
   "apiText": "مَرْيَمَ ۖ"
  },
  {
   "id": "33:8:4",
   "apiText": "صِدْقِهِمْ ۚ"
  },
  {
   "id": "33:9:16",
   "apiText": "تَرَوْهَا ۚ"
  },
  {
   "id": "33:13:10",
   "apiText": "فَٱرْجِعُوا۟ ۚ"
  },
  {
   "id": "33:13:21",
   "apiText": "بِعَوْرَةٍ ۖ"
  },
  {
   "id": "33:15:9",
   "apiText": "ٱلْأَدْبَـٰرَ ۚ"
  },
  {
   "id": "33:17:15",
   "apiText": "رَحْمَةًۭ ۚ"
  },
  {
   "id": "33:18:1",
   "apiText": "۞ قَدْ"
  },
  {
   "id": "33:18:9",
   "apiText": "إِلَيْنَا ۖ"
  },
  {
   "id": "33:19:2",
   "apiText": "عَلَيْكُمْ ۖ"
  },
  {
   "id": "33:19:15",
   "apiText": "ٱلْمَوْتِ ۖ"
  },
  {
   "id": "33:19:24",
   "apiText": "ٱلْخَيْرِ ۚ"
  },
  {
   "id": "33:19:30",
   "apiText": "أَعْمَـٰلَهُمْ ۚ"
  },
  {
   "id": "33:20:4",
   "apiText": "يَذْهَبُوا۟ ۖ"
  },
  {
   "id": "33:20:16",
   "apiText": "أَنۢبَآئِكُمْ ۖ"
  },
  {
   "id": "33:22:13",
   "apiText": "وَرَسُولُهُۥ ۚ"
  },
  {
   "id": "33:23:8",
   "apiText": "عَلَيْهِ ۖ"
  },
  {
   "id": "33:23:15",
   "apiText": "يَنتَظِرُ ۖ"
  },
  {
   "id": "33:24:11",
   "apiText": "عَلَيْهِمْ ۚ"
  },
  {
   "id": "33:25:8",
   "apiText": "خَيْرًۭا ۚ"
  },
  {
   "id": "33:25:12",
   "apiText": "ٱلْقِتَالَ ۚ"
  },
  {
   "id": "33:27:7",
   "apiText": "تَطَـُٔوهَا ۚ"
  },
  {
   "id": "33:30:11",
   "apiText": "ضِعْفَيْنِ ۚ"
  },
  {
   "id": "33:31:1",
   "apiText": "۞ وَمَن"
  },
  {
   "id": "33:32:6",
   "apiText": "ٱلنِّسَآءِ ۚ"
  },
  {
   "id": "33:33:8",
   "apiText": "ٱلْأُولَىٰ ۖ"
  },
  {
   "id": "33:33:15",
   "apiText": "وَرَسُولَهُۥٓ ۚ"
  },
  {
   "id": "33:34:9",
   "apiText": "وَٱلْحِكْمَةِ ۚ"
  },
  {
   "id": "33:36:16",
   "apiText": "أَمْرِهِمْ ۗ"
  },
  {
   "id": "33:37:25",
   "apiText": "تَخْشَىٰهُ ۖ"
  },
  {
   "id": "33:37:44",
   "apiText": "وَطَرًۭا ۚ"
  },
  {
   "id": "33:38:10",
   "apiText": "لَهُۥ ۖ"
  },
  {
   "id": "33:38:17",
   "apiText": "قَبْلُ ۚ"
  },
  {
   "id": "33:39:10",
   "apiText": "ٱللَّهَ ۗ"
  },
  {
   "id": "33:40:12",
   "apiText": "ٱلنَّبِيِّـۧنَ ۗ"
  },
  {
   "id": "33:43:10",
   "apiText": "ٱلنُّورِ ۚ"
  },
  {
   "id": "33:44:4",
   "apiText": "سَلَـٰمٌۭ ۚ"
  },
  {
   "id": "33:48:9",
   "apiText": "ٱللَّهِ ۚ"
  },
  {
   "id": "33:49:18",
   "apiText": "تَعْتَدُّونَهَا ۖ"
  },
  {
   "id": "33:50:43",
   "apiText": "ٱلْمُؤْمِنِينَ ۗ"
  },
  {
   "id": "33:50:57",
   "apiText": "حَرَجٌۭ ۗ"
  },
  {
   "id": "33:51:1",
   "apiText": "۞ تُرْجِى"
  },
  {
   "id": "33:51:8",
   "apiText": "تَشَآءُ ۖ"
  },
  {
   "id": "33:51:15",
   "apiText": "عَلَيْكَ ۚ"
  },
  {
   "id": "33:51:26",
   "apiText": "كُلُّهُنَّ ۚ"
  },
  {
   "id": "33:51:31",
   "apiText": "قُلُوبِكُمْ ۚ"
  },
  {
   "id": "33:52:19",
   "apiText": "يَمِينُكَ ۗ"
  },
  {
   "id": "33:53:26",
   "apiText": "لِحَدِيثٍ ۚ"
  },
  {
   "id": "33:53:33",
   "apiText": "مِنكُمْ ۖ"
  },
  {
   "id": "33:53:38",
   "apiText": "ٱلْحَقِّ ۚ"
  },
  {
   "id": "33:53:45",
   "apiText": "حِجَابٍۢ ۚ"
  },
  {
   "id": "33:53:49",
   "apiText": "وَقُلُوبِهِنَّ ۚ"
  },
  {
   "id": "33:53:63",
   "apiText": "أَبَدًا ۚ"
  },
  {
   "id": "33:55:21",
   "apiText": "أَيْمَـٰنُهُنَّ ۗ"
  },
  {
   "id": "33:55:23",
   "apiText": "ٱللَّهَ ۚ"
  },
  {
   "id": "33:56:6",
   "apiText": "ٱلنَّبِىِّ ۚ"
  },
  {
   "id": "33:59:11",
   "apiText": "جَلَـٰبِيبِهِنَّ ۚ"
  },
  {
   "id": "33:59:17",
   "apiText": "يُؤْذَيْنَ ۗ"
  },
  {
   "id": "33:60:1",
   "apiText": "۞ لَّئِن"
  },
  {
   "id": "33:61:1",
   "apiText": "مَّلْعُونِينَ ۖ"
  },
  {
   "id": "33:62:7",
   "apiText": "قَبْلُ ۖ"
  },
  {
   "id": "33:63:4",
   "apiText": "ٱلسَّاعَةِ ۖ"
  },
  {
   "id": "33:63:9",
   "apiText": "ٱللَّهِ ۚ"
  },
  {
   "id": "33:65:3",
   "apiText": "أَبَدًۭا ۖ"
  },
  {
   "id": "33:69:12",
   "apiText": "قَالُوا۟ ۚ"
  },
  {
   "id": "33:71:6",
   "apiText": "ذُنُوبَكُمْ ۗ"
