{
  "name": "@quran-grammar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --external:express --external:cors --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/app.test.ts src/db/db.test.ts",
    "db:sqlite": "node --disable-warning=ExperimentalWarning --import tsx src/db/cli.ts sqlite",
    "db:verify-sqlite": "node --disable-warning=ExperimentalWarning --import tsx src/db/cli.ts verify-sqlite",
    "db:postgres-sql": "node --disable-warning=ExperimentalWarning --import tsx src/db/cli.ts postgres-sql",
    "db:sync-postgres": "node --disable-warning=ExperimentalWarning --import tsx src/db/cli.ts sync-postgres",
    "db:verify-postgres": "node --disable-warning=ExperimentalWarning --import tsx src/db/cli.ts verify-postgres"
  },
  "dependencies": {
    "@quran-grammar/core": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
