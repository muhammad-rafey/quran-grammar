{
  "name": "@quran-grammar/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "db": "node --disable-warning=ExperimentalWarning scripts/ensure-db.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/ensure-db.mjs && expo start",
    "android": "node --disable-warning=ExperimentalWarning scripts/ensure-db.mjs && expo start --android",
    "ios": "node --disable-warning=ExperimentalWarning scripts/ensure-db.mjs && expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning scripts/ensure-db.mjs && node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "export": "node --disable-warning=ExperimentalWarning scripts/ensure-db.mjs && expo export --platform ios --platform android",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.26",
    "@quran-grammar/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
